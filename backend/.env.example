# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mikrotik
POSTGRES_USER=mikrotik
POSTGRES_PASS=mikrotik

# MikroTik Router
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=443
MIKROTIK_USER=admin
MIKROTIK_PASS=yourpassword
MIKROTIK_SSL=true

# Web App Auth
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASS=admin123

# Server
PORT=3001

# Email Notifications (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL_TO=you@gmail.com

# Google Chat Webhook
GOOGLE_CHAT_WEBHOOK=https://chat.googleapis.com/v1/spaces/XXXXX/messages?key=...

# Google Drive Backup (Service Account JSON path)
GDRIVE_SERVICE_ACCOUNT_PATH=./gdrive-service-account.json
GDRIVE_FOLDER_ID=your-google-drive-folder-id

# Monitoring thresholds (percentage)
THRESHOLD_WARNING=80
THRESHOLD_CRITICAL=90

# WAN interface name on MikroTik (for bandwidth monitoring)
WAN_INTERFACE=ether1

# WAN bandwidth limit in Mbps (for % calculation)
WAN_BANDWIDTH_MBPS=100

# 3BB upstream gateway to ping for connectivity check
ISP_GATEWAY=10.1.0.1
